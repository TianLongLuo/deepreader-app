generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  documents        Document[]
  preferences      UserPreference[]
  sessions         Session[]
  readingProgress  ReadingProgress[]
  readingEntries   ReadingEntry[]

  vocabularySenses     VocabularySense[]
  vocabularyEncounters VocabularyEncounter[]
  reviewLogs           ReviewLog[]
  reviewSessions       ReviewSession[]
  senseChanges         SenseChange[]
  enrichmentJobs       EnrichmentJob[]
  wordExposures        WordExposure[]
  learningTasks        LearningTask[]
  learningResponses    LearningResponse[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

// ============================================================
// WORKSPACES
// ============================================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  documents       Document[]
  aiProviders     AIProviderConfig[]
  promptTemplates PromptTemplate[]
  preferences     UserPreference[]
  aiJobs          AIJob[]

  vocabularySenses     VocabularySense[]
  vocabularyEncounters VocabularyEncounter[]
  reviewLogs           ReviewLog[]
  reviewSessions       ReviewSession[]
  senseChanges         SenseChange[]
  enrichmentJobs       EnrichmentJob[]
  wordExposures        WordExposure[]
  learningTasks        LearningTask[]
  learningResponses    LearningResponse[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  title        String
  fileType     String // "PDF" or "EPUB"
  storageKey   String
  fileSize     Int
  status       String   @default("PENDING")
  parseStatus  String   @default("PENDING")
  language     String?
  pageCount    Int?
  metadataJson String? // Stored as string in sqlite instead of Json type natively supported in PG
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections             DocumentSection[]
  paragraphs           Paragraph[]
  readingProgress      ReadingProgress[]
  readingEntries       ReadingEntry[]
  vocabularyEncounters VocabularyEncounter[]
  wordExposures        WordExposure[]

  @@index([workspaceId])
  @@index([userId])
  @@map("documents")
}

// ============================================================
// DOCUMENT STRUCTURE
// ============================================================

model DocumentSection {
  id              String  @id @default(cuid())
  documentId      String
  parentSectionId String?
  title           String
  orderIndex      Int
  anchor          String
  metadataJson    String?

  document      Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentSection DocumentSection?  @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections DocumentSection[] @relation("SectionHierarchy")
  paragraphs    Paragraph[]

  @@index([documentId])
  @@index([parentSectionId])
  @@map("document_sections")
}

model Paragraph {
  id             String  @id @default(cuid())
  documentId     String
  sectionId      String?
  orderIndex     Int
  pageNumber     Int?
  rawText        String
  normalizedText String
  textHash       String
  startOffset    Int
  endOffset      Int
  metadataJson   String?

  document     Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section      DocumentSection?       @relation(fields: [sectionId], references: [id])
  sentences    Sentence[]
  explanations ParagraphExplanation[]

  @@index([documentId])
  @@index([sectionId])
  @@index([textHash])
  @@map("paragraphs")
}

model Sentence {
  id             String @id @default(cuid())
  paragraphId    String
  orderIndex     Int
  rawText        String
  normalizedText String
  startOffset    Int
  endOffset      Int

  paragraph       Paragraph        @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  annotationSpans AnnotationSpan[]

  @@index([paragraphId])
  @@map("sentences")
}

// ============================================================
// AI EXPLANATIONS & ANNOTATIONS
// ============================================================

model ParagraphExplanation {
  id                   String   @id @default(cuid())
  paragraphId          String
  provider             String
  model                String
  promptVersion        String
  settingsHash         String
  outputJson           String // Storing JSON string for SQLite compatibility
  rawPromptEncrypted   String?
  rawResponseEncrypted String?
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  paragraph       Paragraph        @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  annotationSpans AnnotationSpan[]
  vocabularyNotes VocabularyNote[]

  @@index([paragraphId])
  @@index([settingsHash])
  @@map("paragraph_explanations")
}

model AnnotationSpan {
  id                     String  @id @default(cuid())
  paragraphExplanationId String
  sentenceId             String?
  startOffset            Int
  endOffset              Int
  spanType               String
  label                  String
  colorKey               String
  explanation            String

  paragraphExplanation ParagraphExplanation @relation(fields: [paragraphExplanationId], references: [id], onDelete: Cascade)
  sentence             Sentence?            @relation(fields: [sentenceId], references: [id])

  @@index([paragraphExplanationId])
  @@map("annotation_spans")
}

model VocabularyNote {
  id                     String  @id @default(cuid())
  paragraphExplanationId String
  term                   String
  lemma                  String?
  note                   String
  translation            String?
  difficultyLevel        String?

  paragraphExplanation ParagraphExplanation @relation(fields: [paragraphExplanationId], references: [id], onDelete: Cascade)

  @@index([paragraphExplanationId])
  @@map("vocabulary_notes")
}

// ============================================================
// AI PROVIDER CONFIGURATION
// ============================================================

model AIProviderConfig {
  id                  String    @id @default(cuid())
  workspaceId         String
  providerKey         String
  isEnabled           Boolean   @default(true)
  baseUrl             String
  encryptedApiKey     String
  maskedApiKeyPreview String
  model               String
  temperature         Float     @default(0.3)
  maxTokens           Int       @default(384000)
  topP                Float     @default(1.0)
  timeoutMs           Int       @default(300000)
  retryCount          Int       @default(2)
  streamingEnabled    Boolean   @default(false)
  saveRawPrompt       Boolean   @default(false)
  saveRawResponse     Boolean   @default(false)
  saveRequestInput    Boolean   @default(false)
  cacheEnabled        Boolean   @default(true)
  isDefault           Boolean   @default(false)
  priority            Int       @default(0)
  lastTestedAt        DateTime?
  lastTestStatus      String?
  lastTestMessage     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
  @@map("ai_provider_configs")
}

// ============================================================
// PROMPT TEMPLATES
// ============================================================

model PromptTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  templateType String // "SYSTEM", "PARAGRAPH_EXPLANATION", "REPAIR"
  version      String
  name         String
  content      String
  isActive     Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("prompt_templates")
}

// ============================================================
// USER PREFERENCES
// ============================================================

model UserPreference {
  id                           String   @id @default(cuid())
  userId                       String
  workspaceId                  String
  preferredExplanationLanguage String   @default("en")
  preferredBilingualMode       Boolean  @default(false)
  preferredGrammarMode         Boolean  @default(true)
  preferredAnnotationLayers    String   @default("[]") // Stored as JSON string
  readerTheme                  String   @default("dark")
  savedDraftJson               String? // JSON string
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("user_preferences")
}

// ============================================================
// AI JOBS
// ============================================================

model AIJob {
  id           String   @id @default(cuid())
  workspaceId  String
  jobType      String // "PARSE_DOCUMENT", "GENERATE_EXPLANATION"
  targetId     String
  status       String   @default("QUEUED")
  attemptCount Int      @default(0)
  errorMessage String?
  metadataJson String? // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([targetId])
  @@index([status])
  @@map("ai_jobs")
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  location   String
  percentage Float    @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@map("reading_progress")
}

model ReadingEntry {
  id                  String               @id @default(cuid())
  dedupKey            String?              @unique
  userId              String
  documentId          String
  kind                String
  text                String
  note                String               @default("")
  location            String               @default("")
  createdAt           DateTime             @default(now())
  reviewAt            DateTime?
  reviewCount         Int                  @default(0)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  document            Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  vocabularyEncounter VocabularyEncounter?

  @@index([userId, documentId])
  @@index([userId, kind, reviewAt])
  @@map("reading_entries")
}

model AuthAttempt {
  key       String   @id
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("auth_attempts")
}

// Additive learning entities; original ReadingEntry remains compatibility evidence.
model VocabularySense {
  id                    String                @id @default(cuid())
  userId                String
  workspaceId           String
  sourceLanguage        String
  lemma                 String
  confirmedDictionaryId String?
  senseKey              String
  status                String                @default("unresolved")
  meaningEn             String                @default("")
  meaningZh             String                @default("")
  manualMeaningEn       String?
  manualMeaningZh       String?
  pos                   String                @default("")
  semanticCategory      String                @default("")
  domain                String?
  encounterContext      String                @default("")
  tagsJson              String                @default("[]")
  manualTagsJson        String?
  collocationsJson      String                @default("[]")
  frequencyZipf         Float?
  frequencyVersion      String?
  frequencySource       String?
  frequencyCheckedAt    DateTime?
  priority              Int                   @default(0)
  revision              Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  encounters            VocabularyEncounter[]
  cards                 ReviewCard[]
  enrichmentJobs        EnrichmentJob[]
  learningEvidence      LearningEvidence[]

  @@unique([userId, workspaceId, sourceLanguage, lemma, senseKey])
  @@index([userId, workspaceId, createdAt])
  @@map("vocabulary_senses")
}

model VocabularyEncounter {
  id                   String          @id @default(cuid())
  senseId              String
  userId               String
  workspaceId          String
  readingEntryId       String          @unique
  documentId           String
  location             String
  surface              String
  targetSentence       String
  context              String
  rawNote              String
  legacyContextMeaning String          @default("")
  dictionaryJson       String          @default("null")
  phonetic             String          @default("")
  createdAt            DateTime        @default(now())
  lastSeenAt           DateTime        @default(now())
  sense                VocabularySense @relation(fields: [senseId], references: [id], onDelete: Cascade)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document             Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  readingEntry         ReadingEntry    @relation(fields: [readingEntryId], references: [id], onDelete: Cascade)
  sessions             ReviewSession[]

  @@index([userId, workspaceId, documentId])
  @@map("vocabulary_encounters")
}

model ReviewCard {
  id         String          @id @default(cuid())
  senseId    String
  ability    String          @default("recognition")
  archivedAt DateTime?
  stateJson  String
  due        DateTime
  version    Int             @default(0)
  createdAt  DateTime        @default(now())
  sense      VocabularySense @relation(fields: [senseId], references: [id], onDelete: Cascade)
  logs       ReviewLog[]
  sessions   ReviewSession[]

  @@unique([senseId, ability])
  @@index([due])
  @@map("review_cards")
}

model ReviewLog {
  id          String     @id @default(cuid())
  cardId      String
  userId      String
  workspaceId String
  operationId String
  sessionId   String
  rating      String
  reviewedAt  DateTime
  beforeJson  String
  afterJson   String
  logJson     String
  card        ReviewCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, operationId])
  @@index([cardId, reviewedAt])
  @@map("review_logs")
}

model ReviewSession {
  id                 String              @id @default(cuid())
  userId             String
  workspaceId        String
  cardId             String
  encounterId        String
  cardVersion        Int
  senseRevision      Int
  definitionLanguage String
  expiresAt          DateTime
  revealedAt         DateTime?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  card               ReviewCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  encounter          VocabularyEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, expiresAt])
  @@map("review_sessions")
}

model EnrichmentJob {
  id               String          @id @default(cuid())
  userId           String
  workspaceId      String
  senseId          String
  expectedRevision Int
  targetSenseId    String?
  status           String          @default("queued")
  attempts         Int             @default(0)
  availableAt      DateTime        @default(now())
  leaseUntil       DateTime?
  leaseToken       String?
  errorCode        String?
  progressJson     String          @default("{}")
  eventVersion     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sense            VocabularySense @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([senseId, expectedRevision])
  @@index([status, availableAt])
  @@map("enrichment_jobs")
}

model WordExposure {
  id             String    @id @default(cuid())
  userId         String
  workspaceId    String
  documentId     String
  sourceLanguage String
  lemma          String
  location       String
  sourceHash     String
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId, sourceLanguage, location, lemma, sourceHash])
  @@index([userId, workspaceId, sourceLanguage, lemma])
  @@map("word_exposures")
}

model SenseChange {
  id               String    @id @default(cuid())
  userId           String
  workspaceId      String
  action           String
  sourceIdsJson    String
  targetId         String
  encounterIdsJson String
  detailJson       String
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, createdAt])
  @@map("sense_changes")
}

model LearningTask {
 id String @id @default(cuid())
 userId String
 workspaceId String
 mode String
 sourceLanguage String
 definitionLanguage String
 level String
 wordCount Int @default(250)
 targetCount Int @default(6)
 targetsJson String
 deferredJson String @default("[]")
 domain String?
 passage String @default("")
 questionsJson String @default("[]")
 answerKeyJson String @default("[]")
 applicationPrompt String @default("")
 validationJson String @default("{}")
 status String @default("generating")
 version Int @default(0)
 usedHint Boolean @default(false)
 openedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 responses LearningResponse[]
 @@index([userId,workspaceId,createdAt])
 @@map("learning_tasks")
}
model LearningResponse {
 id String @id @default(cuid())
 taskId String
 userId String
 workspaceId String
 operationId String
 responseJson String
 feedbackJson String @default("{}")
 usedHint Boolean @default(false)
 status String @default("generating")
 previousResponseId String?
 version Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 task LearningTask @relation(fields:[taskId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 evidence LearningEvidence[]
 @@unique([userId,workspaceId,operationId])
 @@index([taskId,createdAt])
 @@map("learning_responses")
}
model LearningEvidence {
 id String @id @default(cuid())
 responseId String
 senseId String
 kind String
 result Boolean?
 reason String
 usedHint Boolean @default(false)
 disputed Boolean @default(false)
 createdAt DateTime @default(now())
 response LearningResponse @relation(fields:[responseId],references:[id],onDelete:Cascade)
 sense VocabularySense @relation(fields:[senseId],references:[id],onDelete:Cascade)
 @@unique([responseId,senseId,kind])
 @@index([senseId,kind,createdAt])
 @@map("learning_evidence")
}
