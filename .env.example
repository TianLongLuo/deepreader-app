# Copy to .env.production. Never commit the filled file.
DATABASE_URL="file:./dev.db"
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTERS"
APP_BASE_URL="https://reader.example.com"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage"
MAX_UPLOAD_SIZE="209715200"
ADMIN_EMAIL="admin@example.com"
ADMIN_LOGIN_NAME="Lone"
# bcrypt hash; use: node scripts/admin-password.mjs
ADMIN_PASSWORD_HASH=""
# true only behind a trusted proxy that overwrites X-Real-IP and blocks direct access
AUTH_TRUST_PROXY="false"
# Optional Redis/S3 settings; no credentials are bundled.
# REDIS_URL="redis://127.0.0.1:6379"
